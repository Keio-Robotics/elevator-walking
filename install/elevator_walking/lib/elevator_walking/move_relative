#!/usr/bin/python3
# EASY-INSTALL-ENTRY-SCRIPT: 'elevator-walking','console_scripts','move_relative'
__requires__ = 'elevator-walking'
import re
import sys
from pkg_resources import load_entry_point

if __name__ == '__main__':
    sys.argv[0] = re.sub(r'(-script\.pyw?|\.exe)?$', '', sys.argv[0])
    sys.exit(
        load_entry_point('elevator-walking', 'console_scripts', 'move_relative')()
    )
